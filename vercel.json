{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/admin.js": { "maxDuration": 60 },
    "api/cron-weekly.js": { "maxDuration": 60 },
    "api/cron-daily.js": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/cron-weekly", "schedule": "0 7 * * 1" },
    { "path": "/api/cron-daily", "schedule": "15 0 * * *" }
  ],
  "redirects": [
