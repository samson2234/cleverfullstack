{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/web-development", "destination": "/blog/web-development", "permanent": true },
    { "source": "/shopify-vs-woocommerce", "destination": "/blog/shopify-vs-woocommerce", "permanent": true },
    { "source": "/seo-tips-2026", "destination": "/blog/seo-tips-2026", "permanent": true },
    { "source": "/website-cost-2026", "destination": "/blog/website-cost-2026", "permanent": true },
    { "source": "/website-mistakes-conversions", "destination": "/blog/website-mistakes-conversions", "permanent": true },
    { "source": "/custom-vs-nocode", "destination": "/blog/custom-vs-nocode", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/blog/web-development", "destination": "/blog/web-development.html" },
    { "source": "/blog/shopify-vs-woocommerce", "destination": "/blog/shopify-vs-woocommerce.html" },
    { "source": "/blog/seo-tips-2026", "destination": "/blog/seo-tips-2026.html" },
    { "source": "/blog/website-cost-2026", "destination": "/blog/website-cost-2026.html" },
    { "source": "/blog/website-mistakes-conversions", "destination": "/blog/website-mistakes-conversions.html" },
    { "source": "/blog/custom-vs-nocode", "destination": "/blog/custom-vs-nocode.html" },
    { "source": "/((?!404|api).*)", "destination": "/$1.html" }
  ]
}
