    { "source": "/", "has": [{ "type": "host", "value": "cleverfullstack.vercel.app" }], "destination": "https://cleverstack.dev/", "permanent": true },
    { "source": "/:path*", "has": [{ "type": "host", "value": "cleverfullstack.vercel.app" }], "destination": "https://cleverstack.dev/:path*", "permanent": true },
